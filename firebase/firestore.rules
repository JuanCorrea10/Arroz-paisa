rules_version = '2';

// Reglas de Firestore para Arroz Paisa.
//
// Se pegan en la consola de Firebase: Firestore Database > Reglas. Primero
// borrar TODO lo que haya en el editor, pegar esto completo y Publicar.
// La linea "rules_version" tiene que ser la primera del archivo.
//
// Son lo que de verdad protege los datos: la app esconde pantallas, pero
// esto es lo que impide que una cuenta de personal cambie un precio aunque
// sepa como.
//
// Roles: cada cuenta tiene un documento usuarios/{uid} con rol y nombre.
//   administrador   todo.
//   personal        anota pedidos (consumos), crea y corrige personas, y
//                   ensena apodos del dictado. No toca precios, platos,
//                   empresas, compras ni la configuracion.
// Sin documento de usuario, la cuenta no ve nada: nadie es administrador por
// accidente.

service cloud.firestore {
  match /databases/{base}/documents {

    function entro() {
      return request.auth != null;
    }

    function tieneCuenta() {
      return entro() && exists(/databases/$(base)/documents/usuarios/$(request.auth.uid));
    }

    function esAdministrador() {
      return tieneCuenta()
        && get(/databases/$(base)/documents/usuarios/$(request.auth.uid)).data.rol == "administrador";
    }

    // Cada quien lee su propio documento de usuario; el administrador, todos.
    match /usuarios/{uid} {
      allow read: if entro() && (request.auth.uid == uid || esAdministrador());
      allow write: if esAdministrador();
    }

    // Lo del dia a dia: cualquiera con cuenta.
    match /consumos/{id} {
      allow read, write: if tieneCuenta();
    }
    match /personas/{id} {
      allow read, create, update: if tieneCuenta();
      allow delete: if esAdministrador();
    }
    match /apodos/{id} {
      allow read, write: if tieneCuenta();
    }
    // Los botones rapidos de Registrar (el especial del dia y los fijos).
    // No mueven plata: los puede poner quien este en la cocina.
    match /rapidos/{id} {
      allow read, write: if tieneCuenta();
    }

    // Lo que se tira el funcionamiento: solo el administrador.
    match /productos/{id} {
      allow read: if tieneCuenta();
      allow write: if esAdministrador();
    }
    match /precios/{id} {
      allow read: if tieneCuenta();
      allow write: if esAdministrador();
    }
    match /empresas/{id} {
      allow read: if tieneCuenta();
      allow write: if esAdministrador();
    }
    match /compras/{id} {
      allow read: if tieneCuenta();
      allow write: if esAdministrador();
    }
    match /config/{id} {
      allow read: if tieneCuenta();
      allow write: if esAdministrador();
    }
  }
}
